# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Orthodontic version unlock overrides (HMAC secret)
OVERRIDE_TOKEN_SECRET=

# Co-browsing support relay (standalone socket server, see server/support-socket.js).
# Point this at the deployed relay (https://your-relay-host:4000) so users OUTSIDE
# localhost can be serviced. When unset, the app falls back to the current
# origin's hostname on port 4000 (same protocol, so no mixed content).
NEXT_PUBLIC_SOCKET_SERVER_URL=

# Phase 5 — VAPID web push (generate keys: node scripts/generate-vapid.mjs apply)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@diamondlink.app

# Shared secret for the Supabase pg_net webhook that triggers chat push when no
# tab is open. Must match the _secret value in the SQL migration.
PUSH_WEBHOOK_SECRET=
